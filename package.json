{
  "name": "pyoor-web",
  "version": "0.1.0",
  "private": true,
  "description": "Pyoor: salt from Sambhar Lake. Next.js storefront.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/brand/razorpay-logo.mjs",
    "build": "next build",
    "start": "wrangler pages dev out --port 8788",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "models": "bash tools/3d/compress.sh",
    "models:inspect": "bash tools/3d/compress.sh --inspect",
    "glyphs": "node tools/glyphs/build.mjs",
    "engravings": "node tools/engravings/build.mjs",
    "test:scroll": "playwright test --workers=1",
    "test:unit": "vitest run",
    "db:seed:gen": "esbuild server/gen-seed.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.wrangler/gen-seed.mjs && node .wrangler/gen-seed.mjs",
    "db:local": "npm run db:seed:gen && wrangler d1 migrations apply pyoor --local && wrangler d1 execute pyoor --local --file=db/seed.sql",
    "dev:cf": "next build && HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose up --build cf",
    "dev:cf:down": "docker compose down"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "hono": "4.13.22",
    "lenis": "1.3.27",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250408.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "opentype.js": "1.3.4",
    "paper": "0.12.18",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "3.114.17"
  }
}
